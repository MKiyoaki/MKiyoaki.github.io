\title{Representation vs. Execution: SFT and RL under Distribution Shift}
\taxon{Mini Project}
\tag{Reinforcement Learning}
\tag{Mechanistic Interpretability}
\import{macros}
\meta{institution}{\ucam (L101)}
\meta{position}{Supervisor: Prof. \andreasvlachos}
\date{2026}

\ul{
  \li{Investigated post-training dynamics (SFT vs. GRPO) under distributional shifts on Qwen2.5-1.5B using Structural Causal Models and layer-wise linear probing. }
  \li{Demonstrated that outcome-based RL restores syntactic compliance (98.2\%) while latent causal rules remain internally encoded (66\% probe accuracy) despite generative execution failure.}
}
