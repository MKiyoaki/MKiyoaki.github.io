\title{Sparse Feature Circuits in Sycophantic Behaviour}
\taxon{Mini Project}
\tag{Mechanistic Interpretability}
\import{macros}
\meta{institution}{\ucam (L193)}
\meta{position}{Supervisor: Prof. Mateja Jamnik}
\date{2026}

\ul{
  \li{Applied [Sparse Feature Circuits (SFC) and SHIFT framework](https://arxiv.org/abs/2403.19647) with JumpReLU SAEs (Gemma Scope) on Gemma-2-2B to analyze model sycophancy across NLP, Philosophy, and Political domains. }
  \li{Showed that targeted ablation of #{10^2 - 10^3} sparse features reduces sycophancy rates from 85.2\% to 45.2\% with minimal capability degradation.}
}
