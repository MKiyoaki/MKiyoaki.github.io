\title{Multi-Agent RL: Algorithm for Sequential Social Dilemmas}
\taxon{Thesis}
\tag{Reinforcement Learning}
\import{macros}
\meta{institution}{\kcl}
\meta{position}{Supervisor: Dr. Milad Kazemi}
\date{2025}

\ul{
  \li{Reproduced and extended MARL pipelines for sequential social dilemmas in [XuanCe](https://github.com/agi-brain/xuance), including MeltingPot integration, visual-observation support, prosocial reward sharing, and the MOCA contract-augmentation framework.}
  \li{Evaluated multiple MARL methods across MPE, MeltingPot, and CleanUp; MAPPO exceeded the original single-agent PPO baseline on CleanUp by 69.3\% (2-agent) and 94.8\% (4-agent), with reproduced MOCA yielding additional gains over separate training.}
}
