\title{Multi-Agent RL: Algorithm Design for Social Dilemmas}
\taxon{Thesis}
\tag{Reinforcement Learning}
\import{macros}
\meta{institution}{\kcl}
\meta{position}{Supervisor: Dr. Milad Kazemi}
\date{2025}

\ul{
  \li{Evaluated independent and centralized MARL algorithms (IPPO, MAPPO, MADDPG, MOCA) with CNN visual extensions and prosocial reward shaping across MPE, MeltingPot, and CleanUp social dilemmas using [XuanCe](https://github.com/agi-brain/xuance).}
  \li{Outperformed single-agent PPO baselines on CleanUp by +69.3\% (2-agent) and +94.8\% (4-agent), achieving peak episode rewards (~600) with visual observation models.}
}
