\title{AI Reasoning Verification: Stepwise Verification via NLI}
\import{macros}
\meta{institution}{MPhil Thesis | \ucam}
\meta{position}{Supervisor: Prof. Andreas Vlachos}
\date{2026}

\p{Formulated NLI-based reformulations for stepwise verification, demonstrating that discriminative SFT significantly outperforms generative training (Supported by the Alan Turing Institute).}
